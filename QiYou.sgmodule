[Panel]
QiYou = script-name=QiYou,update-interval=43200

[Script]
QiYou = type=generic,timeout=15,script-path=https://raw.githubusercontent.com/shuikezhang/qiyou-surge-panel/main/QiYou.js?v=20261028-four-sections-1,argument={{{省份拼音}}}
